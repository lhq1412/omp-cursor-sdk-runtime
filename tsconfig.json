{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test", "scripts"]
}
