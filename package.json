{
  "name": "omp-cursor-sdk-runtime",
  "version": "0.4.1",
  "description": "OMP provider adapter for the official @cursor/sdk local agent runtime",
  "author": "lhq1412 (https://github.com/lhq1412)",
  "license": "MIT",
  "keywords": [
    "omp-plugin",
    "omp",
    "oh-my-pi",
    "cursor",
    "cursor-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhq1412/omp-cursor-sdk-runtime.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate test",
    "probe:sdk": "bun scripts/sdk-contract-probe.ts",
    "probe:omp": "bun scripts/omp-contract-probe.ts",
    "smoke:install": "bun scripts/omp-install-smoke.ts",
    "check:boundaries": "bun scripts/check-boundaries.ts"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.32",
    "@oh-my-pi/pi-ai": "18.3.0",
    "@oh-my-pi/pi-catalog": "18.3.0",
    "@oh-my-pi/pi-coding-agent": "18.3.0",
    "@oh-my-pi/pi-utils": "18.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^6.0.3"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
